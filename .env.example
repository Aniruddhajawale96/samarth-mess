# ⚠️ Security note: NEVER commit real credentials in this file (or any file).
# This template must only ever contain placeholders or local-development values.

# ── Runtime ─────────────────────────────────────────────────────────────
NODE_ENV=development

PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379

# ── Database ────────────────────────────────────────────────────────────
# Local development default — matches the `postgres` service in docker-compose.yml
# (host-run `pnpm dev` reaches it on localhost:5432).
# For a hosted database (Supabase / Neon) replace with YOUR OWN connection string.
# ⚠️ Never commit a real connection string — it contains the database password.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/samarth_mess

# ── Supabase (optional — only if RLS user-context queries are enabled) ──
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

# ── Auth ────────────────────────────────────────────────────────────────
JWT_SECRET=dev_jwt_secret_replace_this_in_production_32chars
JWT_EXPIRES_IN=7d

COOKIE_SECRET=dev_cookie_secret_replace_in_prod_32chars!!

# ── Payments (Razorpay) ─────────────────────────────────────────────────
# Use sandbox keys (rzp_test_...) for development; real keys only in production env.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# ── WhatsApp (optional — invoice delivery) ──────────────────────────────
WHATSAPP_API_KEY=placeholder_api_key
WHATSAPP_PHONE_NUMBER_ID=placeholder_number_id
WHATSAPP_API_URL=https://graph.facebook.com/v20.0
