# ─────────────────────────────────────────────────────────────────────────────
# Samarth Mess — Environment Variables
#
# Copy this file to .env and fill in real values before starting the app.
# All variables without a default in code are REQUIRED in production.
# Never commit the real .env file — it is in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ───────────────────────────────────────────────────────────────────
# Options: development | test | production
NODE_ENV=development

# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Required. Must start with postgres:// or postgresql://
DATABASE_URL=postgres://postgres:postgres@localhost:5432/samarth_mess

# ── Authentication ────────────────────────────────────────────────────────────
# REQUIRED. Must be at least 32 characters. Never use a placeholder in production.
JWT_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_EXPIRES_IN=7d

# REQUIRED in production. Must be at least 32 characters.
COOKIE_SECRET=REPLACE_WITH_A_RANDOM_32_PLUS_CHARACTER_SECRET

# ── Payment Gateway (Razorpay) ────────────────────────────────────────────────
# Optional — leave blank until payment integration is wired up.
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# ── WhatsApp Notifications ────────────────────────────────────────────────────
# Optional — leave blank until WhatsApp integration is wired up.
WHATSAPP_API_KEY=placeholder_api_key
WHATSAPP_PHONE_NUMBER_ID=placeholder_number_id
WHATSAPP_API_URL=https://graph.facebook.com/v20.0

# ── Storage (S3-compatible / GCS) ─────────────────────────────────────────────
# Optional — leave blank until file upload is wired up.
# STORAGE_BUCKET=
# STORAGE_REGION=
