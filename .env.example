# Node Environment
NODE_ENV=development

# Server Ports & URLs
PORT=4000
API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/samarth_mess

# Authentication / Session Secrets
JWT_SECRET=super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Payment Gateway (Razorpay placeholder)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# WhatsApp Notification (Placeholder)
WHATSAPP_API_KEY=placeholder_api_key
WHATSAPP_PHONE_NUMBER_ID=placeholder_number_id
